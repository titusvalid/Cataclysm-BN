#~ "ткани."

#~ msgid "Road-Runner"
#~ msgstr "Марафонец"

#~ msgid ""
#~ "Your legs are extremely limber and fast-moving.  You move 30% faster on "
#~ "flat surfaces."
#~ msgstr ""
#~ "Ваши ноги очень гибкие и быстро движущиеся. Вы передвигаетесь на 30% "
#~ "быстрее на ровной поверхности."

#~ msgid "Stubby Tail"
