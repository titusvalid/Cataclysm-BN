#~ msgstr ""
#~ "<color_blue>R</color> Река — большинство существ не могут переплывать "
#~ "реки, в отличие от вас."

#~ msgid ""
#~ "<color_dark_gray>O</color>           Parking lot - Empty lot, few items. "
