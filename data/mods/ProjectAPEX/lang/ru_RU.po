#~ msgstr "%1$s разрывает противника (%2$s) своими огромными клыками!"

#~ msgid "Hyper-Metabolism"
#~ msgstr "Гиперметаболизм"

#~ msgid ""
#~ "You metabolize nutrients so rapidly that you can convert food directly "
#~ "into useful tissue.  Excess nutrition will convert to HP, rather than "
