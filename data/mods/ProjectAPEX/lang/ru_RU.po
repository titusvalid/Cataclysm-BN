#~ msgstr[1] "Звукоизлучателя"
#~ msgstr[2] "Звукоизлучателей"
#~ msgstr[3] "Шумелки"

#~ msgid ""
#~ "A malfunctioning bionic.  It will occasionally emit a loud burst of noise."
#~ msgstr ""
#~ "Неисправная бионическая система. Время от времени издаёт резкие, громкие "
