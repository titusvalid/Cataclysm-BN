#~ msgid ""
#~ "This is a government-issued, air-dropped alert.  \"EVACUATION ALERT.  "
#~ "Please make your way to the nearest FEMA evacuation shelter.  Avoid "
#~ "crowds.  Looters and rioters may turn violent against unarmed civilians.  "
#~ "Seek protection from police and military forces if traveling in groups.\""
